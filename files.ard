use ard/testing

use go:fmt
use migr/types
use go:os
use go:strconv
use go:strings

private fn error_message(error: Error) Str {
  error.error()
}

fn is_dir(path: Str) Bool {
  let info = try os::Stat(path) -> _ { false }
  info.IsDir()
}

fn exists(path: Str) Bool {
  try os::Stat(path) -> _ { false }
  true
}

fn read_file(path: Str) Str!Str {
  let bytes = try os::ReadFile(path).map_err(error_message)
  Result::ok(Str::from(bytes))
}

fn write_file(path: Str, content: Str) Void!Str {
  os::WriteFile(path, mut content.bytes(), 420).map_err(error_message)
}

fn make_dir(path: Str) Void!Str {
  os::MkdirAll(path, 493).map_err(error_message)
}

fn ensure_dir_exists(path: Str) Void!Str {
  match is_dir(path) {
    true => Result::ok(()),
    false => Result::err("Missing migrations directory: {path}"),
  }
}

fn parse_direction(raw: Str) types::Direction!Str {
  let dirs: [Str: Int] = ["up": 0, "down": 1]
  let index = dirs.get(raw).or(-1)
  try testing::assert(index >= 0, "Invalid migration direction: {raw}")
  let dir = match index {
    0 => types::Direction::up,
    _ => types::Direction::down,
  }
  Result::ok(dir)
}

fn parse_part(filename: Str) types::MigrationPart!Str {
  let pieces = strings::Split(filename, ".")
  
  try testing::assert(pieces.size() == 3, "Invalid migration filename: {filename}")
  try testing::assert(
    pieces.at(2).expect("bounds checked") == "sql",
    "Invalid migration filename: {filename}",
  )
  
  let direction = try parse_direction(pieces.at(1).expect("bounds checked"))
  let base = pieces.at(0).expect("bounds checked")
  let base_parts = strings::Split(base, "_")
  
  try testing::assert(
    base_parts.size() >= 2,
    "Migration filename must be <number>_<name>.<up|down>.sql: {filename}",
  )
  
  let number = match strconv::Atoi(base_parts.at(0).expect("bounds checked")) {
    ok(n) => n,
    err(_) => 0,
  }
  try testing::assert(number > 0, "Migration number must be a positive integer: {filename}")
  
  Result::ok(
    types::MigrationPart{
      number: number,
      name: base,
      direction: direction,
      filename: filename,
    },
  )
}

fn is_migration_sql(filename: Str) Bool {
  filename.contains(".sql")
}

fn has_part(parts: [types::MigrationPart], name: Str, direction: types::Direction) Bool {
  mut found = false
  for part in parts {
    if part.name == name and part.direction == direction {
      found = true
    }
  }
  found
}

fn has_migration_name(migrations: [types::Migration], name: Str) Bool {
  mut found = false
  for migration in migrations {
    if migration.name == name {
      found = true
    }
  }
  found
}

fn has_migration_number(migrations: [types::Migration], number: Int, except_name: Str) Bool {
  mut found = false
  for migration in migrations {
    if migration.number == number and not migration.name == except_name {
      found = true
    }
  }
  found
}

fn sort_migrations(migrations: mut [types::Migration]) [types::Migration] {
  mut left = 0
  while left < migrations.size() {
    mut right = left + 1
    while right < migrations.size() {
      let right_m = migrations.at(right).expect("bounds checked")
      let left_m = migrations.at(left).expect("bounds checked")
      if right_m.number < left_m.number {
        migrations.swap(left, right)
      }
      right = right + 1
    }
    left = left + 1
  }
  
  migrations.@
}

fn build_migration_name(number: Int, raw_name: Str) Str {
  let prefix = match {
    number < 10 => "000{number}",
    number < 100 => "00{number}",
    number < 1000 => "0{number}",
    _ => number.to_str(),
  }
  "{prefix}_{raw_name}"
}

fn load(dir: Str) [types::Migration]!Str {
  try ensure_dir_exists(dir)
  let entries = try os::ReadDir(dir).map_err(error_message)
  
  let parts: mut [types::MigrationPart] = mut []
  for entry in entries {
    if (not entry.IsDir()) and is_migration_sql(entry.Name()) {
      let parsed = try parse_part(entry.Name())
      parts.push(parsed)
    }
  }
  
  let migrations: mut [types::Migration] = mut []
  
  for part in parts {
    match part.direction {
      types::Direction::up => {
        try testing::assert(
          not has_migration_name(migrations.@, part.name),
          "Duplicate up migration: {part.filename}",
        )
        try testing::assert(
          not has_migration_number(migrations.@, part.number, part.name),
          "Duplicate migration number: {part.number}",
        )
        try testing::assert(
          has_part(parts.@, part.name, types::Direction::down),
          "Missing down migration for {part.name}",
        )
        
        let _ = migrations.push(
          types::Migration{
            number: part.number,
            name: part.name,
            up_path: "{dir}/{part.name}.up.sql",
            down_path: "{dir}/{part.name}.down.sql",
          },
        )
      },
      types::Direction::down => (),
    }
  }
  
  for part in parts {
    match part.direction {
      types::Direction::down => {
        try testing::assert(
          has_part(parts.@, part.name, types::Direction::up),
          "Missing up migration for {part.name}",
        )
      },
      types::Direction::up => (),
    }
  }
  
  Result::ok(sort_migrations(migrations))
}

fn next_number(dir: Str) Int!Str {
  try ensure_dir_exists(dir)
  let entries = try os::ReadDir(dir).map_err(error_message)
  
  mut max_number = 0
  for entry in entries {
    if (not entry.IsDir()) and is_migration_sql(entry.Name()) {
      let part = try parse_part(entry.Name())
      if part.number > max_number {
        max_number = part.number
      }
    }
  }
  
  Result::ok(max_number + 1)
}

fn is_valid_slug(name: Str) Bool {
  not name.trim().is_empty() and not name.contains(" ") and not name.contains("/") and not name.contains("\\") and not name.contains(".")
}

fn create(dir: Str, raw_name: Str) Void!Str {
  try ensure_dir_exists(dir)
  try testing::assert(
    is_valid_slug(raw_name),
    "Migration name must be a slug without spaces, slashes, or dots",
  )
  
  let number = try next_number(dir)
  let migration_name = build_migration_name(number, raw_name)
  let up_path = "{dir}/{migration_name}.up.sql"
  let down_path = "{dir}/{migration_name}.down.sql"
  
  try testing::assert(not exists(up_path), "Migration already exists: {migration_name}")
  try testing::assert(not exists(down_path), "Migration already exists: {migration_name}")
  
  try write_file(up_path, "-- Write SQL to apply migration: {migration_name}\n")
  try write_file(down_path, "-- Write SQL to rollback migration: {migration_name}\n")
  
  fmt::Println("Created migration files:")
  fmt::Println("- {up_path}")
  fmt::Println("- {down_path}")
  Result::ok(())
}

fn init(dir: Str) Void!Str {
  match is_dir(dir) {
    true => {
      fmt::Println("Migrations directory already exists: {dir}")
      Result::ok(())
    },
    false => {
      try make_dir(dir)
      fmt::Println("Created migrations directory: {dir}")
      Result::ok(())
    },
  }
}

fn read_sql(path: Str) Str!Str {
  read_file(path)
}

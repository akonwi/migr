use decode
use sql

fn connect(database_url: Str) sql::Database!Str {
  match database_url.is_empty() {
    true => Result::err("Database URL is required"),
    false => sql::open(database_url),
  }
}

fn init_table(db: sql::Database) Void!Str {
  try db.exec(
    `
      CREATE TABLE IF NOT EXISTS schema_migrations (
        name TEXT PRIMARY KEY,
        batch INTEGER NOT NULL,
        applied_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
      )
      `,
  )

  Result::ok(())
}

fn is_applied(db: sql::Database, name: Str) Bool!Str {
  let rows = try db.query("SELECT COUNT(*) AS count FROM schema_migrations WHERE name = @name").all(["name": name])

  match rows.size() {
    0 => Result::ok(false),
    _ => {
      let row = rows.at(0).expect("size checked")
      let count = try decode::run(row, decode::field("count", decode::int)) -> err { Result::err(err.to_str()) }
      Result::ok(count > 0)
    },
  }
}

fn latest_batch(db: sql::Database) Int!Str {
  let rows = try db.query("SELECT COALESCE(MAX(batch), 0) AS max_batch FROM schema_migrations").all([:])

  match rows.size() {
    0 => Result::ok(0),
    _ => {
      let row = rows.at(0).expect("size checked")
      let max_batch = try decode::run(row, decode::field("max_batch", decode::int)) -> err { Result::err(err.to_str()) }
      Result::ok(max_batch)
    },
  }
}

fn record(tx: sql::Transaction, name: Str, batch: Int) Void!Str {
  try tx.query(
    "INSERT INTO schema_migrations (name, batch) VALUES (@name, @batch)",
  ).run(["name": name, "batch": batch])

  Result::ok(())
}

fn remove(tx: sql::Transaction, name: Str) Void!Str {
  try tx.query("DELETE FROM schema_migrations WHERE name = @name").run(["name": name])
  Result::ok(())
}

fn applied(db: sql::Database) [Str]!Str {
  let rows = try db.query("SELECT name FROM schema_migrations ORDER BY name ASC").all([:])

  let names: mut [Str] = mut []
  for row in rows {
    let name = try decode::run(row, decode::field("name", decode::string)) -> err { Result::err(err.to_str()) }
    names.push(name)
  }

  Result::ok(deref names)
}

fn last_batch_migrations(db: sql::Database) [Str]!Str {
  let rows = try db.query(
    "SELECT name FROM schema_migrations WHERE batch = (SELECT COALESCE(MAX(batch), 0) FROM schema_migrations) ORDER BY name DESC",
  ).all([:])

  let names: mut [Str] = mut []
  for row in rows {
    let name = try decode::run(row, decode::field("name", decode::string)) -> err { Result::err(err.to_str()) }
    names.push(name)
  }

  Result::ok(deref names)
}

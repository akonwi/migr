use ard/testing
use migr/types

fn infer(database_url: Str) types::Dialect!Str {
  let trimmed = database_url.trim()

  try testing::assert(not trimmed.is_empty(), "Database URL cannot be empty")
  try testing::assert(not trimmed.contains("@tcp("), "MySQL is not supported in v1")
  try testing::assert(not trimmed.contains("@unix("), "MySQL is not supported in v1")

  match {
    trimmed.starts_with("postgres://") => Result::ok(types::Dialect::postgres),
    trimmed.starts_with("postgresql://") => Result::ok(types::Dialect::postgres),
    _ => Result::ok(types::Dialect::sqlite),
  }
}
